# Copia este archivo como .env (en local) o crea estos valores en
# Hugging Face → Settings → Variables and secrets. NUNCA subas el .env a Git.

# Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_publica

# Solo si tu proyecto usa "Legacy JWT secret" (Project Settings → JWT Keys).
# Déjalo vacío si usa las nuevas claves asimétricas (JWKS).
SUPABASE_JWT_SECRET=

# Dominio(s) del frontend separados por coma
CORS_ORIGINS=http://localhost:5173,https://tu-app.vercel.app

MAX_IMAGE_MB=5
RATE_LIMIT_POR_MINUTO=20
UMBRAL_CONFIANZA=0.75
