# Copia este archivo como .env (en local) o crea estos valores en
# Azure → Container App → Containers → Environment variables. NUNCA subas el .env a Git.

# Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_publica

# Solo si tu proyecto usa "Legacy JWT secret" (Project Settings → JWT Keys).
# Déjalo vacío si usa las nuevas claves asimétricas (JWKS).
SUPABASE_JWT_SECRET=

# Supabase → Project Settings → API Keys → service_role (secret).
# Solo para el registro de auditoría y para que el admin active/desactive cuentas.
# Es una clave MUY sensible: solo en este .env y en Azure como secreto, nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Dominio(s) del frontend separados por coma
CORS_ORIGINS=http://localhost:5173,https://tu-app.vercel.app

MAX_IMAGE_MB=5
RATE_LIMIT_POR_MINUTO=20
# Bloqueo temporal tras N contraseñas incorrectas seguidas de un mismo correo
LOGIN_MAX_FALLOS=5
LOGIN_BLOQUEO_MINUTOS=15
UMBRAL_CONFIANZA=0.75
